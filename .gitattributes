# Auto detect text files and perform LF normalization
* text=auto

# HTML files
*.html text eol=lf

# CSS files
*.css text eol=lf

# JavaScript files
*.js text eol=lf

# JSON files
*.json text eol=lf

# Markdown files
*.md text eol=lf

# Image files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg binary

# Video files
*.mp4 binary
*.webm binary
*.mov binary

# Data files
*.csv text eol=lf
*.geojson text eol=lf
